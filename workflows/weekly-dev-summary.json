    "Extract Summary Text": {
      "main": [
        [
          {
            "node": "Route Delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Delivery": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send via Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
