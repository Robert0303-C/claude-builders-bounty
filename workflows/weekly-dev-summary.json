        ]
      ]
    },
    "Read Config": {
      "main": [
        [
          {
            "node": "Fetch Commits (GitHub)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs (GitHub)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues (GitHub)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits (GitHub)": {
